
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nouva AI — Intelligence, réunie</title>
<style>
:root {
  --bg: #090a0c;
  --panel: #15171b;
  --border: #30333a;
  --text: #f4f5f7;
  --muted: #969ba5;
  --silver: #d5d8df;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, system-ui, sans-serif;
}
button, textarea, select { font: inherit; }
button { cursor: pointer; }
.app {
  display: grid;
  grid-template-columns: 245px 1fr;
  min-height: 100vh;
}
.sidebar {
  background: #08090b;
  border-right: 1px solid #24262c;
  padding: 22px 15px;
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 20px;
  font-weight: 750;
}
.logo {
  width: 39px;
  height: 39px;
  border: 1px solid #aeb3bd;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: radial-gradient(circle, #555b65, #111);
  color: white;
  font-size: 20px;
}
.brand small {
  display: block;
  font-size: 9px;
  letter-spacing: 2px;
  color: var(--muted);
}
.new-chat, .nav button {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 11px;
  background: transparent;
  color: var(--text);
  text-align: left;
}
.nav { display: grid; gap: 5px; }
.nav button { border-color: transparent; color: #b7bbc3; }
.nav button:hover, .nav button.active {
  background: #1c1e23;
  color: white;
}
.nav-title {
  font-size: 10px;
  letter-spacing: 1.5px;
  color: #777d87;
  margin: 0 10px 8px;
}
.sidebar-bottom {
  margin-top: auto;
  color: var(--muted);
  font-size: 12px;
}
main {
  min-width: 0;
  position: relative;
  min-height: 100vh;
  padding: 22px 25px 170px;
}
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--muted);
  font-size: 12px;
}
.avatar {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: #111;
  background: linear-gradient(135deg, white, #777);
  font-weight: bold;
}
.center {
  max-width: 850px;
  margin: auto;
}
.welcome {
  text-align: center;
  padding: 15vh 10px 35px;
}
.welcome h1 {
  font-size: clamp(34px, 5vw, 58px);
  line-height: 1.1;
  letter-spacing: -2px;
}
.silver {
  background: linear-gradient(100deg, white, #969ba5, white);
  color: transparent;
  background-clip: text;
}
.welcome p {
  color: var(--muted);
  max-width: 550px;
  margin: auto;
}
.suggestions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 25px;
}
.suggestions button {
  border: 1px solid var(--border);
  border-radius: 30px;
  padding: 9px 13px;
  background: #14161a;
  color: #c7cbd2;
}
.messages {
  display: grid;
  gap: 22px;
  max-width: 760px;
  margin: auto;
}
.message {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.message.user { justify-content: flex-end; }
.bubble {
  max-width: 85%;
  padding: 13px 16px;
  border-radius: 16px;
  background: #191b20;
  border: 1px solid #292c33;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.user .bubble {
  background: #e5e7eb;
  color: #111;
  border-color: #e5e7eb;
}
.composer-wrap {
  position: fixed;
  bottom: 0;
  left: 245px;
  right: 0;
  padding: 15px 24px;
  background: linear-gradient(transparent, #090a0c 25%);
}
.composer {
  max-width: 850px;
  margin: auto;
  background: #17191e;
  border: 1px solid #3b3e46;
  border-radius: 18px;
  padding: 10px;
}
textarea {
  width: 100%;
  resize: none;
  min-height: 45px;
  max-height: 160px;
  background: transparent;
  color: white;
  border: 0;
  outline: 0;
  padding: 9px;
}
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.tools { display: flex; gap: 7px; }
.tool {
  border: 1px solid #363941;
  background: #22242a;
  color: #d5d8df;
  border-radius: 10px;
  padding: 8px 11px;
}
.send {
  border: 0;
  background: #e5e7eb;
  color: #111;
  border-radius: 10px;
  width: 38px;
  height: 37px;
  font-size: 20px;
}
.hint {
  text-align: center;
  color: #747a84;
  font-size: 10px;
  margin-top: 9px;
}
.hidden { display: none !important; }
.modal {
  position: fixed;
  inset: 0;
  background: #000b;
  display: grid;
  place-items: center;
  padding: 20px;
  z-index: 5;
}
.modal-card {
  background: #15171b;
  border: 1px solid #3b3e46;
  border-radius: 18px;
  padding: 25px;
  width: min(460px, 100%);
}
.modal-card h2 { margin-top: 0; }
.modal-card p { color: var(--muted); }
.price {
  font-size: 38px;
  font-weight: bold;
  margin: 20px 0;
}
.premium-btn {
  width: 100%;
  border: 0;
  background: #e5e7eb;
  color: #111;
  padding: 12px;
  border-radius: 10px;
  font-weight: bold;
}
@media(max-width:750px) {
  .app { grid-template-columns: 1fr; }
  .sidebar { display: none; }
  main { padding: 15px 12px 165px; }
  .composer-wrap { left: 0; padding: 12px; }
  .welcome { padding-top: 12vh; }
}
</style>
</head>
<body>
<div class="app">

<aside class="sidebar">
  <div class="brand">
    <div class="logo">N</div>
    <div>Nouva AI<small>INTELLIGENCE, RÉUNIE</small></div>
  </div>

  <button class="new-chat" id="newChat">＋ Nouvelle conversation</button>

  <div>
    <div class="nav-title">OUTILS IA</div>
    <nav class="nav">
      <button class="active" data-mode="chat">◉ Chat IA</button>
      <button data-mode="image">▧ Générer une image</button>
      <button data-mode="text">✎ Générer un texte</button>
      <button data-mode="code">⌘ Créer du code</button>
      <button data-mode="voice">♫ Assistant vocal</button>
    </nav>
  </div>

  <div>
    <div class="nav-title">ESPACE</div>
    <nav class="nav">
      <button id="historyBtn">◷ Historique</button>
      <button id="premiumBtn">✦ Nouva Premium</button>
      <button id="settingsBtn">⚙ Paramètres</button>
    </nav>
  </div>

  <div class="sidebar-bottom">
    Nouva AI · Votre espace créatif
  </div>
</aside>

<main>
  <header class="topbar">
    <span id="modeLabel">Nouva AI / Chat</span>
    <div class="avatar">N</div>
  </header>

  <section class="center">
    <div class="welcome" id="welcome">
      <div class="brand" style="justify-content:center">
        <div class="logo">N</div>
        Nouva AI
      </div>

      <h1>Que pouvons-nous<br>
        <span class="silver">créer ensemble ?</span>
      </h1>

      <p>
        Discutez, imaginez, écrivez et codez.
        Tous vos outils d'intelligence artificielle réunis.
      </p>

      <div class="suggestions">
        <button data-prompt="Aide-moi à trouver des idées">✦ Trouver des idées</button>
        <button data-prompt="Écris un texte professionnel">✎ Écrire un texte</button>
        <button data-prompt="Je veux créer une image de">▧ Créer une image</button>
        <button data-prompt="Aide-moi à programmer">⌘ Programmer</button>
      </div>
    </div>

    <div class="messages" id="messages"></div>
  </section>
</main>

<div class="composer-wrap">
  <form class="composer" id="composer">
    <textarea id="input" rows="1"
      placeholder="Écrivez votre message à Nouva AI..."></textarea>

    <div class="toolbar">
      <div class="tools">
        <button type="button" class="tool" id="attach">＋</button>
        <input type="file" id="file" hidden>

        <select class="tool" id="mode">
          <option value="chat">✦ Chat IA</option>
          <option value="image">▧ Images</option>
          <option value="text">✎ Texte</option>
          <option value="code">⌘ Code</option>
          <option value="voice">♫ Voix</option>
        </select>
      </div>

      <div class="tools">
        <button type="button" class="tool" id="mic">🎙</button>
        <button type="submit" class="send">↑</button>
      </div>
    </div>
  </form>

  <div class="hint">
    Nouva AI peut faire des erreurs. Vérifiez les informations importantes.
  </div>
</div>
</div>

<div class="modal hidden" id="premiumModal">
  <div class="modal-card">
    <h2>✦ Nouva AI Premium</h2>
    <p>Débloquez une expérience IA plus complète.</p>
    <div class="price">9,99 € <small>/ mois</small></div>
    <p>✓ Accès aux outils IA<br>
       ✓ Génération de texte<br>
       ✓ Création d'images<br>
       ✓ Assistant de code<br>
       ✓ Expérience sans publicité</p>
    <button class="premium-btn" id="subscribe">
      Choisir Premium
    </button>
    <button class="tool" id="closePremium" style="width:100%;margin-top:10px">
      Fermer
    </button>
  </div>
</div>

<script>
const $ = id => document.getElementById(id);

const names = {
  chat: "Chat IA",
  image: "Génération d'images",
  text: "Génération de texte",
  code: "Création de code",
  voice: "Assistant vocal"
};

let currentMode = "chat";
let conversations = [];

function setMode(mode) {
  currentMode = mode;
  $("mode").value = mode;
  $("modeLabel").textContent = "Nouva AI / " + names[mode];

  document.querySelectorAll("[data-mode]").forEach(button => {
    button.classList.toggle("active", button.dataset.mode === mode);
  });

  const placeholders = {
    chat: "Écrivez votre message à Nouva AI...",
    image: "Décrivez l'image que vous imaginez...",
    text: "Que souhaitez-vous rédiger ?",
    code: "Décrivez le code à créer...",
    voice: "Écrivez ici ou utilisez le micro..."
  };

  $("input").placeholder = placeholders[mode];
  $("input").focus();
}

document.querySelectorAll("[data-mode]").forEach(button => {
  button.addEventListener("click", () => setMode(button.dataset.mode));
});

$("mode").addEventListener("change", e => setMode(e.target.value));

function addMessage(text, role) {
  const row = document.createElement("div");
  row.className = "message " + role;

  const bubble = document.createElement("div");
  bubble.className = "bubble";
  bubble.textContent = text;

  row.appendChild(bubble);
  $("messages").appendChild(row);

  return bubble;
}

function sendMessage(text) {
  if (!text.trim()) return;

  $("welcome").classList.add("hidden");
  addMessage(text, "user");

  conversations.push({
    role: "user",
    content: text
  });

  // Démo : les fonctions réelles nécessitent une API IA.
  let response = "";

  switch (currentMode) {
    case "chat":
      response =
        "Nouva AI est prêt à répondre à votre question. " +
        "Connectez un modèle d'intelligence artificielle " +
        "pour activer les réponses réelles.";
      break;

    case "image":
      response =
        "Votre description est prête pour la génération d'image. " +
        "Une API de génération d'images doit être connectée.";
      break;

    case "text":
      response =
        "Votre demande de rédaction est prête. " +
        "Connectez un modèle de texte pour générer votre contenu.";
      break;

    case "code":
      response =
        "Votre demande de programmation est prête. " +
        "Connectez un modèle de code pour obtenir une solution.";
      break;

    case "voice":
      response =
        "Le mode vocal est sélectionné. " +
        "Vous pouvez utiliser le micro si votre navigateur le permet.";
      break;
  }

  addMessage(response, "assistant");

  conversations.push({
    role: "assistant",
    content: response
  });

  $("input").value = "";
  $("input").style.height = "45px";
}

$("composer").addEventListener("submit", e => {
  e.preventDefault();
  sendMessage($("input").value);
});

$("input").addEventListener("keydown", e => {
  if (e.key === "Enter" && !e.shiftKey) {
    e.preventDefault();
    $("composer").requestSubmit();
  }
});

$("input").addEventListener("input", () => {
  $("input").style.height = "auto";
  $("input").style.height =
    Math.min($("input").scrollHeight, 160) + "px";
});

document.querySelectorAll("[data-prompt]").forEach(button => {
  button.addEventListener("click", () => {
    $("input").value = button.dataset.prompt;
    $("input").focus();
  });
});

$("newChat").addEventListener("click", () => {
  $("messages").innerHTML = "";
  $("welcome").classList.remove("hidden");
  conversations = [];
  setMode("chat");
});

$("attach").addEventListener("click", () => {
  $("file").click();
});

$("file").addEventListener("change", e => {
  const file = e.target.files[0];

  if (file) {
    $("input").value +=
      ($("input").value ? "\n" : "") +
      "[Fichier joint : " + file.name + "]";
  }
});

$("mic").addEventListener("click", () => {
  const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if (!SpeechRecognition) {
    addMessage(
      "La reconnaissance vocale n'est pas disponible " +
      "dans ce navigateur. Essayez Chrome ou Edge.",
      "assistant"
    );
    return;
  }

  const recognition = new SpeechRecognition();
  recognition.lang = "fr-FR";

  recognition.onresult = event => {
    $("input").value +=
      event.results[0][0].transcript;
  };

  recognition.onerror = () => {
    addMessage(
      "Impossible d'accéder au micro. Vérifiez les autorisations.",
      "assistant"
    );
  };

  recognition.start();
});

$("premiumBtn").addEventListener("click", () => {
  $("premiumModal").classList.remove("hidden");
});

$("closePremium").addEventListener("click", () => {
  $("premiumModal").classList.add("hidden");
});

$("subscribe").addEventListener("click", () => {
  alert(
    "Le paiement Premium doit être connecté à un prestataire " +
    "de paiement sécurisé avant de pouvoir souscrire."
  );
});

$("settingsBtn").addEventListener("click", () => {
  alert(
    "Paramètres Nouva AI : les préférences et la gestion " +
    "du compte seront disponibles après la création du backend."
  );
});

$("historyBtn").addEventListener("click", () => {
  alert(
    "L'historique persistant nécessite une base de données " +
    "et un compte utilisateur."
  );
});
</script>
</body>
</html>
